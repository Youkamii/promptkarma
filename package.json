{
  "name": "promptkarma",
  "version": "0.0.1",
  "description": "AI CLI 세션 로그에서 사용자 프롬프트만 뽑아 태도(선/악)와 활용 능력을 측정하는 CLI",
  "type": "module",
  "bin": {
    "promptkarma": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "scan": "bun run src/index.ts scan",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
