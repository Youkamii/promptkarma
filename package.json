{
  "name": "promptkarma",
  "version": "0.0.3",
  "description": "Claude Code 프롬프트에서 AI를 대하는 태도와 지시 구조를 배지로 만드는 로컬 CLI",
  "type": "module",
  "bin": {
    "promptkarma": "dist/index.js"
  },
  "files": [
    "dist",
    "public/badge-sample.svg"
  ],
  "scripts": {
    "dev": "bun run scripts/preview.ts",
    "scan": "bun run src/index.ts scan",
    "sample": "bun run scripts/generate-sample.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun run src/core.test.ts && bun run src/polytope.test.ts",
    "prepublishOnly": "bun run typecheck && bun run test",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Youkamii/promptkarma.git"
  },
  "homepage": "https://promptkarma.vercel.app",
  "bugs": "https://github.com/Youkamii/promptkarma/issues",
  "keywords": ["claude-code", "prompt", "local-first", "developer-tools"],
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
